{
  "expo": {
    "name": "Vidora",
    "slug": "vidora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/animations/icon.png",
    "scheme": "vidora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shuvosir.vidora",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/animations/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shuvosir.vidora"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/animations/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-sqlite",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Vidora to access your photos.",
          "savePhotosPermission": "Allow Vidora to save videos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-share-intent"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "71cb15b4-95a2-4eb6-a295-61bf6d554ea0"
      }
    }
  }
}
